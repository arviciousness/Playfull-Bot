# Copy this file to .env and fill in the two values.
# Never commit .env. Never paste the token into config.json or Discord chat.

# Discord Developer Portal → your application → Bot → Reset Token / Copy Token
DISCORD_TOKEN=paste-your-bot-token-here

# Discord Developer Portal → your application → General Information → Application ID
DISCORD_CLIENT_ID=paste-your-application-id-here

# Optional. If set, this overrides guildId in config/config.json.
# DISCORD_GUILD_ID=
