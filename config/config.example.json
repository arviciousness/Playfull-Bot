{
  "_comment": "Copy this file to config/config.json. Do not put a bot token in this file. The token lives only in .env. Keys that start with _ are notes and are ignored.",
  "_contradictions": "See README section 'Playbook contradictions'. Defaults follow the UnbelievaBoat shop (50/90/130/170 and that shop's role rules). Switch presets with /set-preset.",

  "guildId": "",
  "databasePath": "data/playfull.db",

  "channels": {
    "_comment": "Use the channel name (emoji prefixes are ignored) or, better, the numeric channel ID. Staff commands only run in adminCommands. The playbook also mentions #cmds for currency commands; member commands are allowed everywhere unless you fill memberEconomy.",
    "adminCommands": ["admin-cmds"],
    "memberEconomy": [],
    "auditLog": "PlayBits-vault",
    "giveaways": "giveaways",
    "events": "events",
    "shop": "playbits-shop",
    "chatEarn": ["general", "spanish", "japanese", "filipino", "russian"],
    "gamingHubVoice": ["Gaming Hub"]
  },

  "roles": {
    "_comment": "Role name or numeric role ID. The bot only grants these roles. Its own role must sit above every role it assigns.",
    "verified": "verified",
    "moderator": ["Moderator"],
    "admin": ["Discord Management"],
    "serverBooster": "Server Booster",
    "trendHunter": "Trend Hunter",
    "gameCreator": "Game Creator",
    "partyLegend": "Party Legend",
    "playmaker": "Playmaker",
    "playfullPatron": "Playfull Patron",
    "bronzeTicket": "Bronze Ticket Holder",
    "silverTicket": "Silver Ticket Holder",
    "goldTicket": "Gold Ticket Holder",
    "platinumTicket": "Platinum Ticket Holder",
    "diamondTicket": "Diamond Ticket Holder",
    "giveawayAlerts": "Giveaway Alerts"
  },

  "economy": {
    "_comment": "Starting balance is 5 and there is no cap. Balances are never wiped by the weekly reset. Bank is optional storage; the shop spends cash only. p!rob is not implemented.",
    "currencyName": "PlayBits",
    "startingBalance": 5,
    "startingBucket": "cash",
    "maxCash": null,
    "maxBank": null,
    "useBank": true
  },

  "chat": {
    "enabled": true,
    "amount": 1,
    "cooldownSeconds": 60,
    "requireVerified": true,
    "minLength": 2,
    "rejectDuplicates": true,
    "duplicateWindowSeconds": 600,
    "includeThreads": true,
    "countMediaWithoutText": false,
    "ignorePrefixes": ["p!"]
  },

  "audit": {
    "_comment": "Every balance change is written to the database. logChatEarnings also posts each chat award to the vault channel. Turn it off if that channel is too noisy.",
    "logChatEarnings": true
  },

  "moderation": {
    "preventSelfReward": true
  },

  "activities": {
    "trending": {
      "label": "Trending Gameplay",
      "reward": 10,
      "roleKey": "trendHunter",
      "expiresWeekly": true
    },
    "gameplay": {
      "label": "Original Gameplay",
      "reward": 20,
      "roleKey": "gameCreator",
      "expiresWeekly": true
    },
    "gamenight": {
      "label": "Game Nights",
      "reward": 25,
      "roleKey": "partyLegend",
      "expiresWeekly": true
    },
    "gaminghub": {
      "label": "Gaming Hub",
      "reward": 30,
      "roleKey": "playmaker",
      "expiresWeekly": true,
      "minVoiceMinutes": 30
    },
    "purchase": {
      "label": "Playfull Purchase",
      "reward": 40,
      "roleKey": "playfullPatron",
      "expiresWeekly": false
    }
  },

  "boost": {
    "_comment": "Server boost grants the Patron role automatically. grantPlayBits 40 matches the purchase reward. Set grantPlayBits to 0 to grant the role only. countsAsPurchase true means a boost and a purchase share one reward per week.",
    "autoGrantPatron": true,
    "grantPlayBits": 40,
    "countsAsPurchase": true
  },

  "voice": {
    "qualifyMinutes": 30,
    "ignoreDeafened": true,
    "ignoreMuted": false,
    "ignoreAfk": true,
    "heartbeatSeconds": 60
  },

