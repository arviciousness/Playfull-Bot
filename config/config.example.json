  "giveaway": {
    "_comment": "Matches Giveaway Boat where the playbook gave a value: 7 days, color #007FFF, captcha on, stacked entries, private winner thread, giveaways channel. Giveaway Boat's Extra Entries toggle had no amounts written down, so only ticket weights are used. The winner thread message was TBD; the default below is a stand-in.",
    "defaultDurationHours": 168,
    "embedColor": "#007FFF",
    "requireCaptcha": true,
    "stackEntries": true,
    "privateWinnerThread": true,
    "thumbnailUrl": "",
    "autoWeeklyReset": false,
    "defaultWinnerMessage": "Congratulations {winner}! You won **{prize}**. A moderator will contact you here with your Steam key. If the game is region-locked, reply with your country."
  },

  "weeklyReset": {
    "_comment": "Tickets and the four temporary activity roles are removed. Playfull Patron is never removed. PlayBits balances are never reset, even if resetBalances is changed to true.",
    "expireTickets": true,
    "resetBalances": false,
    "rolesToRemove": ["trendHunter", "gameCreator", "partyLegend", "playmaker"],
    "rolesNeverRemove": ["playfullPatron"]
  }
}
